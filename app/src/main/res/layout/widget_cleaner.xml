<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deep Cleaner"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="0% 已用"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_free"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="可用 0 B"
            android:textColor="#CFE1FF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_cleanable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="上次发现 0 B 可清理"
            android:textColor="#CFE1FF"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_scan"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:background="@drawable/widget_button"
        android:gravity="center"
        android:paddingHorizontal="18dp"
        android:text="安全扫描"
        android:textColor="#12356A"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
